# Google Sheets (required for live data)
# 1. Make your sheet public: Share → Anyone with link → Viewer
# 2. Enable Sheets API: console.cloud.google.com → APIs → Google Sheets API
# 3. Create API key: APIs & Services → Credentials → Create API Key
#    (Restrict to Google Sheets API for security)
# Without these vars the site runs on the bundled sample data in src/lib/sample-data.ts.

GOOGLE_SHEET_ID=your_sheet_id_here
# Sheet ID is the long string in your sheet URL:
# https://docs.google.com/spreadsheets/d/THIS_PART_HERE/edit

GOOGLE_SHEETS_API_KEY=<redacted>

# Optional tab-name overrides (defaults shown)
# SHEET_TAB_CATHEDRALS=Cathedrals
# SHEET_TAB_PAGES=Pages
# SHEET_TAB_PARISHES=Parishes
# SHEET_TAB_DIOCESES=Dioceses

# Newsletter (Resend — powers /api/subscribe)
# RESEND_API_KEY=
# RESEND_AUDIENCE_ID=
# SUBMISSION_EMAIL=

# Auth (add Clerk keys when ready)
# NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
# CLERK_SECRET_KEY=

# Stripe (add when ready)
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
